<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.clintrial</groupId>
    <artifactId>clintrial-connect</artifactId>
    <version>1.0.0</version>
    <name>ClinTrial Connect</name>
    <description>Health-sector clinical trial patient-matching platform (Java + MySQL) built for QA/testing practice</description>
    <packaging>jar</packaging>

    <properties>
        <!-- 17 is Spring Boot 3.3's minimum baseline and matches widely-installed JDKs (e.g. Homebrew's
             default `openjdk` formula on macOS). The project uses no Java 21-only language features,
             so this runs unchanged on Java 17, 21, or newer — raise it back to 21 if you specifically
             want to target 21. -->
        <java.version>17</java.version>

        <!-- Allure reporting (see "Allure reports" in README.md) -->
        <allure.version>2.29.0</allure.version>

        <!-- Cucumber BDD (see "Cucumber BDD tests" in README.md). Spring Boot's parent BOM does
             not manage either of these, so both are pinned explicitly. -->
        <cucumber.version>7.20.1</cucumber.version>
        <junit-platform-suite.version>1.10.3</junit-platform-suite.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Selenium UI test skeletons (excluded from default `mvn test` run; see src/test/java/.../selenium) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.24.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Allure JUnit 5 integration: listens to test execution via the JUnit Platform
             TestExecutionListener SPI and writes one result file per test to
             target/allure-results (see the systemPropertyVariables below). -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber BDD: Gherkin .feature files under src/test/resources/features, step
             definitions under com.clintrial.cucumber.steps (see RunCucumberTest, the JUnit
             Platform Suite entry point Surefire picks up automatically). -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Lets step-definition classes be Spring beans (@Autowired MockMvc, repositories, ...)
             sharing one Spring context across all scenarios in a run; see
             CucumberSpringConfiguration. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit-platform-suite.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Feeds Cucumber scenario results into the same target/allure-results directory as the
             JUnit 5 tests (wired via RunCucumberTest's cucumber.plugin configuration), so one
             Allure report covers both. Version is managed by the allure-bom import above. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Selenium tests (incl. the com.clintrial.selenium.automation.* suite) need a
                         real browser + a running server, and the dbintegrity.* suite needs a live
                         MySQL with schema-mysql.sql applied — both are kept out of the default
                         `mvn test` run. Run them explicitly:
                           mvn -Dtest=selenium.**   -DfailIfNoTests=false -Dbase.url=http://localhost:8080 test
                           mvn -Dtest=dbintegrity.** -DfailIfNoTests=false test -->
                    <excludes>
                        <exclude>**/selenium/**</exclude>
                        <exclude>**/dbintegrity/**</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Declaring the plugin here lets IDEs see it and is required for the short-form
                 `mvn allure:report` / `mvn allure:serve` goals to have any chance of resolving.
                 That short form still depends on Maven successfully fetching io.qameta.allure's
                 group-level plugin-prefix metadata, which isn't guaranteed on every machine/
                 Maven-cache combination. The fully-qualified goal always works regardless:
                   mvn io.qameta.allure:allure-maven:2.15.0:serve
                   mvn io.qameta.allure:allure-maven:2.15.0:report
                 See "Allure reports" in README.md. -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.15.0</version>
            </plugin>
        </plugins>
    </build>

</project>
